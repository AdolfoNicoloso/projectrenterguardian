# Cloud Functions no longer need Strapi or Directus secrets.
# App data lives in Firestore; photo bytes in Firebase Storage.
# Auth uses the default Firebase Admin credentials for the project.

# Enable Phone Authentication in Firebase Console (Authentication → Sign-in method).
# Invites are shared as HTTPS links to Firebase Hosting (see WEB_APP_URL).
# No SendGrid/Twilio required.

# Public web origin for invite share links (no trailing slash).
WEB_APP_URL=https://project-renter-guardian.web.app

# Optional: only if you add other local secrets later.
# (Leave empty for Firestore + Storage.)

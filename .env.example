# Expo / Firebase client (public) configuration
# Copy to `.env` in the repo root and fill in values from Firebase Console.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional: override Cloud Functions base URL (defaults to us-central1 project URL)
# EXPO_PUBLIC_FUNCTIONS_BASE_URL=https://us-central1-YOUR_PROJECT.cloudfunctions.net

# Public web app URL (Firebase Hosting) — used for invite links in the client
EXPO_PUBLIC_WEB_APP_URL=https://project-renter-guardian.web.app
